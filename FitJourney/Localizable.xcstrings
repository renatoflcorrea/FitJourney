      }
    },
    "O app do relógio é mais novo que este. Atualize para voltar a sincronizar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Watch app is newer than this one. Update to sync again."
          }
