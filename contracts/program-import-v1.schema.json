{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitjourney.app/contracts/program-import-v1.schema.json",
  "title": "ProgramImport",
  "description": "Extração de programa de treino a partir de arquivos (PDF, foto, texto) — FitJourney v1. Copie o que está escrito; não invente. Campo desconhecido = null, com confidence e notes explicando.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "goal",
    "goalText",
    "scheduleMode",
    "durationWeeks",
    "notes",
    "confidence",
    "source",
    "routines",
    "ambiguities"
  ],
  "properties": {
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome do programa se escrito; null se não houver."
    },
    "goal": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "hypertrophy",
        "strength",
        "endurance",
        "fatLoss",
        "conditioning",
        "rehabilitation",
        "other",
        null
      ],
      "description": "Objetivo quando indicado."
    },
    "goalText": {
      "type": [
        "string",
        "null"
      ],
      "description": "Objetivo como escrito."
    },
    "scheduleMode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "free",
        "sequential",
        "weekly",
        null
      ],
      "description": "weekly se o arquivo liga fichas a dias da semana; sequential se é rodízio A→B→C; null se não indica."
    },
    "durationWeeks": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 52
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "O que estava ambíguo, ilegível ou foi inferido (curto). null se nada."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Confiança na leitura: high = legível e explícito; medium = inferido do contexto; low = ilegível, ambíguo ou adivinhado."
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    },
    "routines": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/routine"
      },
      "description": "Todas as fichas detectadas."
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "page"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Nome do arquivo exatamente como no rótulo [Arquivo: …]."
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Página (1-based) quando houver; null em imagens/texto."
        }
      },
      "description": "Onde o item foi lido."
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "question",
        "options"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Caminho do item, ex.: routines[0].exercises[2].sets."
        },
        "question": {
          "type": "string",
          "description": "Pergunta curta em pt-BR para o usuário."
        },
        "options": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "Respostas possíveis (vazio = resposta livre)."
        }
      },
      "description": "Dúvida que só o usuário resolve (ex.: \"3x12\" = 3 séries de 12 ou 12 séries de 3?)."
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "weekdays",
        "notes",
        "confidence",
        "source",
        "exercises"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nome da ficha como escrito (ex.: \"Peito e tríceps\"); null se não houver."
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "description": "Letra da ficha quando escrita (A, B, C…)."
        },
        "weekdays": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "description": "Dias da semana se o arquivo indicar; senão vazio."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "O que estava ambíguo, ilegível ou foi inferido (curto). null se nada."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Confiança na leitura: high = legível e explícito; medium = inferido do contexto; low = ilegível, ambíguo ou adivinhado."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "exercises": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      },
      "description": "Uma ficha (treino) detectada. Arquivos podem ter várias fichas diferentes: devolva uma por treino."
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asWritten",
        "name",
        "catalogKey",
        "restSeconds",
        "groupLabel",
        "notes",
        "confidence",
        "source",
        "sets"
      ],
      "properties": {
        "asWritten": {
          "type": "string",
          "description": "Nome do exercício exatamente como escrito no arquivo."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nome normalizado em pt-BR (do catálogo quando casar); null se ilegível."
        },
        "catalogKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chave do catálogo do app só quando tiver certeza; senão null."
        },
        "restSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 600,
          "description": "Descanso entre séries, se escrito."
        },
        "groupLabel": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mesmo rótulo na mesma ficha = bi-set/tri-set/circuito."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "O que estava ambíguo, ilegível ou foi inferido (curto). null se nada."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Confiança na leitura: high = legível e explícito; medium = inferido do contexto; low = ilegível, ambíguo ou adivinhado."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "sets": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/set"
          },
          "description": "Uma entrada por série (\"3x12\" = 3 séries)."
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repTarget",
        "holdSeconds",
        "load",
        "loadAsWritten",
        "restSeconds",
        "tempo",
        "rir",
        "rpe",
        "cardio",
        "notes",
        "confidence",
        "source"
      ],
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "warmup",
            "feeder",
            "working",
            "dropSet",
            "restPause",
            "toFailure",
            "backOff",
            null
          ],
          "description": "Tipo da série; null = não indicado (válida)."
        },
        "repTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/repTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "holdSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 600,
          "description": "Sustentação (isométricos)."
        },
        "load": {
          "anyOf": [
            {
              "$ref": "#/$defs/load"
            },
            {
              "type": "null"
            }
          ]
        },
        "loadAsWritten": {
          "type": [
            "string",
            "null"
          ],
          "description": "Carga como escrita quando não foi possível converter (ex.: \"placa 7\", ilegível)."
        },
        "restSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 600
        },
        "tempo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cadência, ex.: \"3-1-1-0\"."
        },
        "rir": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "rpe": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "cardio": {
          "anyOf": [
            {
              "$ref": "#/$defs/cardio"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "O que estava ambíguo, ilegível ou foi inferido (curto). null se nada."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Confiança na leitura: high = legível e explícito; medium = inferido do contexto; low = ilegível, ambíguo ou adivinhado."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "repTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reps",
        "min",
        "max"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fixed",
            "range",
            "amrap"
          ],
          "description": "fixed usa reps; range usa min e max; amrap = máximo possível."
        },
        "reps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "weight",
            "bodyweight"
          ],
          "description": "weight = carga absoluta; bodyweight = peso corporal com value de lastro (+) ou assistência (−)."
        },
        "value": {
          "type": "number",
          "minimum": -200,
          "maximum": 1000
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      }
    },
    "cardio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "distanceMeters",
        "level",
        "speedKmh",
        "inclinePercent",
        "heartRateZone"
      ],
      "properties": {
        "durationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 14400
        },
        "distanceMeters": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 50
        },
        "speedKmh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 50
        },
        "inclinePercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -10,
          "maximum": 40
        },
        "heartRateZone": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
